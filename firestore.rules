rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Admin check (email hardcoded o rol admin en Firestore)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'sebastianbumq@enarapp.com' ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin')
      );
    }

    // Helper: Gestor de usuarios (asistente de admin)
    function isUserManager() {
      return request.auth != null && (
        request.auth.token.email == 'ventas@enar.com.co' ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'gestor')
      );
    }

    // Helper: Usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Usuario aprobado
    function isApproved() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.estado == 'aprobado';
    }

    // Helper: Vendedor (rol guardado en Firestore)
    function isVendedor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'vendedor';
    }

    // Helper: Despachos (rol guardado en Firestore)
    function isDespachos() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'despachos';
    }

    // Helper: Gestor
    function isGestor() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'gestor';
    }

    // Helper: Comercial Líder (vendedor con visibilidad total, flag en su user doc)
    function esComercialLider() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.comercial_lider == true;
    }

    // Helper: Vendedor externo (usuarios.vendedor_externo == true): solo ve las órdenes que él creó
    function esVendedorExterno() {
      return isVendedor() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('vendedor_externo', false) == true;
    }

    // Helper: CRM user (admin, vendedor, despachos o gestor)
    function isCRM() {
      return isAdmin() || isVendedor() || isDespachos() || isGestor();
    }

    // Productos: lectura pública, escritura admin + gestor (Henrry: ventas@enar.com.co)
    match /productos/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || isUserManager();
    }

    // Configuración: solo admin
    match /configuracion/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Usuarios: usuarios pueden leer/escribir su propio doc, admin puede todo
    match /usuarios/{userId} {
      // Cualquier autenticado puede crear su propio documento (registro)
      // Admin, gestores y vendedores pueden crear documentos de otros usuarios
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isUserManager() ||
        isVendedor()
      );

      // GET (doc individual): usuario su propio doc, admin/gestor todos,
      // vendedores/despachos solo usuarios aprobados
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isUserManager() ||
        (isVendedor() && resource.data.estado == 'aprobado') ||
        (isDespachos() && resource.data.estado == 'aprobado')
      );

      // LIST (queries): cualquier autenticado puede hacer queries
      // (necesario para verificar duplicados de email/NIT en registro)
      allow list: if isAuthenticated();

      // Usuario puede actualizar su propio doc (datos limitados)
      // Admin, gestor y vendedores pueden actualizar cualquier usuario
      // Ni el propio usuario ni los vendedores pueden cambiar campos sensibles: comerciales
      // (estado, tipo_cliente, crédito...) ni de permisos (rol, comercial_lider, vendedor_externo).
      // chat_lecturas (mensajes leídos) solo lo cambia su dueño: un vendedor no toca el de otro.
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado', 'tipo_cliente', 'limite_credito', 'plazo_pago', 'descuento_adicional', 'rol', 'comercial_lider', 'vendedor_externo'])) ||
        isAdmin() ||
        isUserManager() ||
        (isVendedor() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado', 'tipo_cliente', 'limite_credito', 'plazo_pago', 'descuento_adicional', 'rol', 'comercial_lider', 'vendedor_externo', 'chat_lecturas']))
      );

      // Solo admin puede eliminar usuarios
      allow delete: if isAdmin();

      // Sedes: subcollection de cada usuario
      match /sedes/{sedeId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == userId || isCRM()
        );
        allow create, update: if isAdmin() || isUserManager();
        // Solo admin puede eliminar sedes
        allow delete: if isAdmin();
      }
    }

    // Carrito: cada usuario solo su propio carrito
    match /carrito/{userId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    // Estados de orden (js/estados-orden.js): pendiente, aprobada, alistamiento, cerrada,
    // cancelada. Cerrada lleva siempre subestado completa | parcial; los demás estados no
    // (null al regresar de cerrada). Los nombres anteriores (en_proceso, terminada,
    // completada, parcial como estado...) ya no se aceptan.
    function estadoOrdenValido(d) {
      return d.get('estado', 'pendiente') in ['pendiente', 'aprobada', 'alistamiento', 'cerrada', 'cancelada'] &&
        (d.get('estado', 'pendiente') == 'cerrada'
          ? d.get('subestado', null) in ['completa', 'parcial']
          : d.get('subestado', null) == null);
    }

    // Órdenes: usuarios aprobados pueden crear y leer sus propias órdenes
    match /ordenes/{ordenId} {
      // Usuarios aprobados pueden crear órdenes (solo sus propias)
      // Admin y vendedores pueden crear órdenes en nombre de clientes
      allow create: if isAuthenticated() && estadoOrdenValido(request.resource.data) && (
        (isApproved() && request.resource.data.user_id == request.auth.uid) ||
        isAdmin() ||
        ((isVendedor() || isGestor()) && request.resource.data.creadaPor == request.auth.uid)
      );

      // Usuarios pueden leer sus propias órdenes; admin/gestores/despachos/comercial_lider
      // y los vendedores internos leen todas (los vendedores solo MODIFICAN las suyas, ver update).
      // Vendedor externo: solo las que él creó (creadaPor), ni las de sus clientes asignados.
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        (esVendedorExterno() && resource.data.creadaPor == request.auth.uid) ||
        (!esVendedorExterno() && (
          isAdmin() ||
          isUserManager() ||
          esComercialLider() ||
          isVendedor() ||
          isDespachos()
        ))
      );

      // Admin, gestores, despachos y comercial_lider pueden actualizar órdenes
      // Usuarios aprobados pueden actualizar sus propias órdenes pendientes
      // Vendedores pueden actualizar órdenes que ellos crearon o de sus clientes asignados
      allow update: if estadoOrdenValido(request.resource.data) && (isAdmin() || isUserManager() || isDespachos() || esComercialLider() ||
        (isVendedor() && (
          resource.data.creadaPor == request.auth.uid ||
          (resource.data.user_id != null &&
            exists(/databases/$(database)/documents/usuarios/$(resource.data.user_id)) &&
            get(/databases/$(database)/documents/usuarios/$(resource.data.user_id)).data.vendedor_asignado == request.auth.uid)
        )) ||
        (isApproved() && resource.data.user_id == request.auth.uid && resource.data.estado == 'pendiente'));

      // Solo admin puede eliminar órdenes
      allow delete: if isAdmin();
    }

    // Cotizaciones: cada usuario crea y lee solo las suyas (user_id); el personal lee y
    // gestiona todas. Las del agente IA se escriben con Admin SDK. Las antiguas sin user_id
    // solo las ve el personal. Crear con un ID ya usado es update: el cliente no puede pisar
    // la cotización de otro.
    match /cotizaciones/{cotizacionId} {
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.get('user_id', null) == request.auth.uid || isCRM());
      allow update: if isCRM();
      allow delete: if isAdmin();
    }

    // Métricas de clientes CRM: lectura para CRM users, escritura solo admin
    match /metricas_clientes/{clienteId} {
      allow read: if isCRM();
      allow write: if isAdmin();
    }

    // Chat de órdenes (mensajes internos): solo personal, nunca clientes. Quien puede
    // leer los mensajes de una orden también puede responderlos: lectura y escritura usan
    // la misma condición, esPersonalChat() || esExternoDeLaOrden(orden del mensaje).
    //   - Personal interno (admin, gestor, vendedor interno, despachos): todas las órdenes.
    //     Va primero y no depende del documento: `||` corta ahí, así sus consultas sin
    //     filtro (avisos de mensajes sin leer) se aprueban.
    //   - Vendedor externo: solo órdenes que él creó (creadaPor); sus consultas deben
    //     filtrar por orden_id.
    // Al escribir, el mensaje va a su nombre (usuario_id). Los mensajes no se editan;
    // borrar solo admin. Lo leído por cada usuario va en usuarios/{uid}.chat_lecturas.
    function esPersonalChat() {
      return isCRM() && !esVendedorExterno();
    }

    function esExternoDeLaOrden(ordenId) {
      return esVendedorExterno() &&
        get(/databases/$(database)/documents/ordenes/$(ordenId)).data.creadaPor == request.auth.uid;
    }

    match /chat_ordenes/{mensajeId} {
      allow read: if esPersonalChat() || esExternoDeLaOrden(resource.data.orden_id);
      allow create: if (esPersonalChat() || esExternoDeLaOrden(request.resource.data.orden_id)) &&
        request.resource.data.usuario_id == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Despachos CRM: lectura para CRM users, escritura para admin/gestor/despachos
    match /despachos/{despachoId} {
      allow read: if isCRM();
      allow write: if isAdmin() || isGestor() || isDespachos();
    }
  }
}
